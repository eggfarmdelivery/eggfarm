NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
KAKAO_REST_API_KEY=
# 주소->좌표 변환(로컬 API) 전용 - 에그팜 앱은 카카오맵 서비스가 꺼져있어서(켜면 과금 요구),
# 이미 카카오맵이 활성화된 "오더모아" 앱의 REST API 키를 대신 씀(앱 키 페이지 > REST API 키)
KAKAO_LOCAL_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_JS_KEY=
# 관리자 단지 요청 히트맵 지도 로딩 전용 - Maps가 이미 활성화된(무료쿼터 있는) 다른 카카오 앱의 JS 키를 씀
# (그 앱의 플랫폼 설정에 이 서비스 도메인도 추가 등록해야 함)
NEXT_PUBLIC_KAKAO_MAPS_JS_KEY=
ADMIN_KAKAO_ID=
# 배송완료 사진 90일 자동삭제 크론(/api/cron/cleanup-delivery-photos) 보호용 - 임의의 랜덤 문자열로 설정
CRON_SECRET=
